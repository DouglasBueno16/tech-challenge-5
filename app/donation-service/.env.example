# ==============================================================================
# Servico & Banco de Dados
# ==============================================================================
PORT=8082
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/donationdb?sslmode=disable

# ==============================================================================
# Mensageria AWS SQS (Assincrono)
# ==============================================================================
AWS_REGION=us-east-1
AWS_SQS_URL=https://sqs.us-east-1.amazonaws.com/123456789012/solidary-donations

# ==============================================================================
# OpenTelemetry (OTel / OTLP) - Comunicacao com Grafana Alloy / OTel Collector
# ==============================================================================
OTEL_SERVICE_NAME=donation-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
DD_TRACE_OTLP_ENABLED=true
DD_TRACE_PROPAGATION_STYLE=tracecontext,datadog

# ==============================================================================
# Datadog APM & AIOps (Watchdog / Applied Intelligence & Continuous Profiler)
# ==============================================================================
DD_SERVICE=donation-service
DD_ENV=local
DD_VERSION=1.0.0
DD_API_KEY=sua_api_key_aqui
DD_SITE=us5.datadoghq.com
DD_AGENT_HOST=localhost
DD_TRACE_AGENT_PORT=8126

# Habilita continuous profiler (CPU, Heap, Goroutines, Mutex) para o Watchdog Insights
DD_PROFILING_ENABLED=true
# Correlaciona logs com trace_id e span_id
DD_LOGS_INJECTION=true
# Metricas de GC, Heap e Goroutines da runtime Go
DD_RUNTIME_METRICS_ENABLED=true
